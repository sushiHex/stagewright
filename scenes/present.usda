def Scope "Render"
{
    def RenderProduct "Hero"
    {
        rel camera = </World/Cameras/Hero>
        custom bool omni:rtx:pt:denoising:enabled = 1
        custom uint omni:rtx:pt:samplesPerPixel = 256
        custom token omni:rtx:rendermode = "PathTracing"
        rel orderedVars = </Render/Hero/Color>
        uniform int2 resolution = (1920, 1080)

        def RenderVar "Color"
        {
